/**
 * Computer — the complete Hack platform: ROM32K + CPU + Memory
 * (Nand2Tetris Project 5, capstone).
 *
 * The ROM holds the program (read-only from the CPU's perspective); the CPU
 * fetches an instruction at `pc`, executes it, and reads/writes `Memory` via
 * its outM/writeM/addressM interface; Memory's output feeds back as inM.
 */
CHIP Computer {
    IN  reset;

    PARTS:
    ROM32K(address=pc, out=instruction);

    CPU(inM=inM, instruction=instruction, reset=reset,
        outM=outM, writeM=writeM, addressM=addressM, pc=pc);

    Memory(in=outM, load=writeM, address=addressM, out=inM);
}
