/**
 * Full adder: adds three bits (a, b, and carry-in c), producing
 * sum and carry-out. Built from two half adders plus an Or on the
 * two carry outputs.
 */
CHIP FullAdder {
    IN a, b, c;
    OUT sum, carry;

    PARTS:
    HalfAdder(a=a, b=b, sum=s1, carry=c1);
    HalfAdder(a=s1, b=c, sum=sum, carry=c2);
    Or(a=c1, b=c2, out=carry);
}
