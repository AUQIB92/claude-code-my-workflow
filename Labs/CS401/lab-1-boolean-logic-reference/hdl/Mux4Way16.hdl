/**
 * Mux4Way16: selects one of 4 sixteen-bit inputs via a 2-bit selector.
 * sel==00 -> a, sel==01 -> b, sel==10 -> c, sel==11 -> d.
 * Composed from Mux16: sel[0] chooses within each pair (a,b) and (c,d);
 * sel[1] chooses between the two pair results.
 */
CHIP Mux4Way16 {
    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];

    PARTS:
    Mux16(a=a, b=b, sel=sel[0], out=ab);
    Mux16(a=c, b=d, sel=sel[0], out=cd);
    Mux16(a=ab, b=cd, sel=sel[1], out=out);
}
